{
  "schema": 2,
  "product": { "name": "C#Bash", "version": "@VERSION@" },
  "destinations": {
    "home": { "fixed": "%USERPROFILE%/.bash", "primary": true },
    "bin":  { "fixed": "home:bin" }
  },
  "artifacts": [
    { "from": "Bash.exe", "to": "bin:", "links": [ "bin:sh.exe" ] },
    { "from": "claude.cmd", "to": "bin:" },
    { "from": "KNOWN_ISSUES.md", "to": "home:" },
    { "from": "KNOWN_LIMITATIONS.md", "to": "home:" }
  ],
  "path": { "add": "bin:", "default": "no" }
}
