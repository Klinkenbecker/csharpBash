--- across blocks
tail -n 3 many                     21:199998|199999|200000|
tail -c 10 many                    10:99|200000|
tail -n 70000 many | head -n 1     7:130001|
head -n -199998 many               4:1|2|
head -n -70000 many | tail -n 1    7:130000|
head -c -1288890 many              5:1|2|3
tail -n 3 < many                   21:199998|199999|200000|
tail -c 10 < many                  10:99|200000|
tail -n 70000 < many | head -n 1   7:130001|
head -n -199998 < many             4:1|2|
head -n -70000 < many | tail -n 1  7:130000|
head -c -1288890 < many            5:1|2|3
cat many | tail -n 3               21:199998|199999|200000|
cat many | tail -c 10              10:99|200000|
cat many | tail -n 70000 | head -n 1 7:130001|
cat many | head -n -199998         4:1|2|
cat many | head -n -70000 | tail -n 1 7:130000|
cat many | head -c -1288890        5:1|2|3
--- a line longer than a block
 tail -n 2: 100007
 tail -n 1: 6
 head -n -1: 100001
cat long |  tail -n 2: 100007
cat long |  tail -n 1: 6
cat long |  head -n -1: 100001
--- several files, a seekable stdin
tail -n 1 nonl three               31:==> nonl <==|b|==> three <==|c|
tail -c 2 nonl crlf                31:==> nonl <==||b|==> crlf <==|^|
tail -n 2 < three                  4:b|c|
head -n -1 < three                 4:a|b|
--- UTF-8 in a capture
kept: 1 é
cut:  a9
