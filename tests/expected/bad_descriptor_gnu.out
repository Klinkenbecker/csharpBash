--- reads, 0<&-
[read v] rc=1 read: read error: 0: Bad file descriptor
[sort] rc=2 sort: stat failed: -: Bad file descriptor
[grep x] rc=2 grep: (standard input): Bad file descriptor
[sed p] rc=4 sed: read error on stdin: Bad file descriptor
[awk 1] rc=2 awk: fatal: error reading input file `-': Bad file descriptor
[tr a b] rc=1 tr: read error: Bad file descriptor
[od -c] rc=1 od: 'standard input': read error: Bad file descriptor
[tee] rc=1 tee: read error: Bad file descriptor
[cat] rc=1 cat: -: Bad file descriptor
[cut -c1] rc=1 cut: -: Bad file descriptor
[md5sum] rc=1 md5sum: -: Bad file descriptor
[xargs echo] rc=1 xargs: error closing file: Bad file descriptor
[head -1] rc=1
[tail -1] rc=1
[wc -l] rc=1
[uniq] rc=1
[base64] rc=1
read: rc=1 v=[old]
mapfile: rc=0 count=0
--- the other forms of an unreadable stdin
0> wo: rc=1 cat: -: Bad file descriptor wo=[]
0>&1: rc=1 cat: -: Bad file descriptor
0>&-: rc=1 cat: -: Bad file descriptor
--- writes
[echo hi >&-] rc=1 echo: write error: Bad file descriptor
[printf hi >&-] rc=1 printf: write error: Bad file descriptor
[pwd >&-] rc=1 pwd: write error: Bad file descriptor
cat in 1< in: rc=1 
1<&-: rc=1 
1< in: rc=1 
a group: rc=1 lines=1
2< in >&2: rc=1 out=[]
nothing written: rc=0
