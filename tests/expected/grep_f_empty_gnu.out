[-vE]: in.txt:a|in.txt:b|in2.txt:c rc=0
[-vP]: in.txt:a|in.txt:b|in2.txt:c rc=0
[-o]:  rc=1
[-vH]: in.txt:a|in.txt:b|in2.txt:c rc=0
[-vl]: in.txt|in2.txt rc=0
[-vL]:  rc=0
